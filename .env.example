# ---------------------------------------------------------------------------
# Firebase — client config (safe to expose)
# ---------------------------------------------------------------------------
# These identify the project; they do not authorise anything. Access control
# lives in firestore.rules and in the server-side session checks. Copy them
# from Firebase console → Project settings → Your apps → Web app → SDK setup.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — server only. THESE ARE SECRETS.
# ---------------------------------------------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private
# key. Never prefix these with NEXT_PUBLIC_, or they ship to the browser.
#
# FIREBASE_PRIVATE_KEY spans multiple lines: keep the literal \n sequences and
# wrap the whole value in double quotes. The code converts them back.

FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Provider API keys are NOT set here.
# ---------------------------------------------------------------------------
# OpenRouter / Gemini / Sarvam keys are entered by each user in the app's
# Settings panel and stay in that user's browser. Keeping them out of the
# server means PentAI is never custodian of anyone's billable credentials.
